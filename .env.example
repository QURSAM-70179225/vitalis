# ---------------------------------------------------------------------------
# Real accounts + Mission Control sync (Supabase). Leave empty to run fully local.
# Find both values in Supabase → Project Settings → API.
# Use the "anon public" key ONLY. Never put the service_role key in this app.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI explanation layer (OFF by default). The app is 100% functional without it.
# Get a key at https://console.groq.com, set it here, then enable the layer in Settings.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.1-8b-instant
